{
  "manifest_version": 3,
  "name": "Save to Quiet",
  "version": "0.1.0",
  "description": "One click (or Alt+Shift+S) to save the current page to your Quiet reading list.",
  "permissions": ["activeTab", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Save to Quiet" },
  "options_page": "options.html",
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save this page to Quiet" } }
}
